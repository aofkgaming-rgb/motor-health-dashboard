# Copy to .env for local runs (npm run dev). Never commit the real .env.

# Shared secret Board B sends in the X-Device-Key header to POST /api/v1/telemetry.
# Use a long random string and flash the same value into the Board B firmware.
DEVICE_KEY="change-me-to-a-long-random-string"

# Start the labelled demo simulation when no device is connected (true/false).
DEMO_AUTOSTART="true"
